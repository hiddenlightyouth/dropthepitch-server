# 배포할 이미지. 롤백 가능하도록 커밋 SHA로 지정한다
APP_IMAGE=ghcr.io/hiddenlightyouth/dropthepitch-server:<commit-sha>
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# 외부 Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

JWT_SECRET_KEY=
CORS_ALLOWED_ORIGINS=https://hiddenlightyouth.yuns.kr
GEMINI_API_KEY=
# 기본값이 없어 빠지면 부팅 실패한다
SPRING_AI_GOOGLE_GENAI_TIMEOUT=600s

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2

# 최초 1회만 update, 스키마 생성 후 줄 삭제
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
